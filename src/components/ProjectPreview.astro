---
import { type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ArrowRight from '../icons/ArrowRight.astro';

type Props = { project: CollectionEntry<'projects'>; class?: string; headingLevel?: 'h2' | 'h3' };

const { project, class: className, headingLevel = 'h2' } = Astro.props;
const { title, description, seo } = project.data;
const TitleTag = headingLevel;
---

<a class:list={['flex flex-col sm:flex-row justify-between items-start gap-6 group project-card', className]} href={`/projects/${project.id}/`}>
    {
        seo?.image?.src && (
            <div class="w-full sm:w-48 md:w-56 flex-shrink-0 order-2 sm:order-1">
                <div class="aspect-video w-full rounded-lg overflow-hidden bg-muted">
                    <Image
                        src={seo.image.src}
                        alt={seo.image.alt || title}
                        width={400}
                        height={225}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                </div>
            </div>
        )
    }
    <div class="grow order-1 sm:order-2">
        <div class="flex items-center gap-3">
            <TitleTag
                class="text-xl leading-tight font-serif font-medium group-hover:underline group-hover:decoration-dashed group-hover:underline-offset-4 group-hover:decoration-1 sm:text-2xl"
            >
                {title}
            </TitleTag>
            {/* Ongoing status badge removed because 'status' does not exist in project.data */}
        </div>
        {description && <div class="mt-1 text-sm leading-normal">{description}</div>}
        <div class="mt-4 font-serif italic opacity-70 group-hover:opacity-100 transition inline-flex gap-1 items-center">
            View Project <ArrowRight class="fill-current w-4 h-4" />
        </div>
    </div>
</a>

<script>
    import { animateOnScroll } from '../utils/animation-utils';

    document.addEventListener('astro:page-load', () => {
        // Animate project cards on scroll using consolidated utility
        animateOnScroll('.project-card', {
            duration: 0.6,
            ease: 'power3.out',
            y: 50
        });
    });
</script>
