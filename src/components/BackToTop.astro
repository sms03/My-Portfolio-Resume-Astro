---
import RemixIcon from './RemixIcon.astro';
---

<button
    id="backToTop"
    class="fixed bottom-6 right-6 z-50 p-3 rounded-lg bg-main text-main shadow-lg transition-transform duration-300 hover:scale-110 hover:bg-main/80 focus:outline-none"
    aria-label="Back to top"
    onclick="window.scrollTo({top: 0, behavior: 'smooth'});"
>
    <RemixIcon name="arrow-up-line" size="20" />
</button>
<script>
    // Hide button when at the top, show when scrolled down
    window.addEventListener('scroll', () => {
        const btn = document.getElementById('backToTop');
        if (btn) {
            if (window.scrollY > 200) {
                btn.style.display = 'block';
            } else {
                btn.style.display = 'none';
            }
        }
    });

    // Set initial display state on page load
    window.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('backToTop');
        if (btn) {
            btn.style.display = window.scrollY > 200 ? 'block' : 'none';
        }
    });
</script>
